APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# En producciÃ³n: APP_URL=https://tudominio.com y FORCE_HTTPS=true
# FORCE_HTTPS activa redirecciÃ³n https:// independiente de APP_ENV
FORCE_HTTPS=false

APP_PRODUCT_NAME="ZuraEdu"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# â”€â”€ Generador de horarios â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Activa trazas detalladas del algoritmo (solo en desarrollo)
HORARIO_DEBUG=false
# MÃ¡ximo de iteraciones de backtracking por intento (default: 150000)
HORARIO_MAX_ITER=150000
# Tope de tiempo real en segundos para TODO el proceso (default: 30) — red de
# seguridad independiente de HORARIO_MAX_ITER, evita que una configuracion
# grande de franjas/aulas deje la generacion corriendo por minutos.
HORARIO_MAX_TIME=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=

# Si esta instalación usa CACHE_DRIVER=redis en producción: fija CACHE_PREFIX,
# REDIS_PREFIX y SESSION_COOKIE explícitamente (ver .env real de cada tenant).
# Evita perder toda la caché/sesiones cuando Laravel cambia el prefijo por
# defecto (guiones en vez de guion bajo) — hazlo antes de actualizar Laravel.
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# â”€â”€ Datos institucionales â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SCHOOL_NAME="Mi Centro Educativo"
SCHOOL_NIVEL="Nivel Secundario"
SCHOOL_CODIGO="12345"

# â”€â”€ Asistente IA (Google Gemini) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Obtener clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Stripe (pagos SaaS) ────────────────────────────────────────────────────
# Obtener claves en: https://dashboard.stripe.com/apikeys
# Webhook secret: https://dashboard.stripe.com/webhooks → endpoint /webhook/stripe
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Laravel Reverb (WebSockets en tiempo real) ─────────────────────────────
# Requerido para asistencia QR, notificaciones y chat en tiempo real
REVERB_APP_ID=sge_psac
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=https
