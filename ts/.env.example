# ── API (apps/api) ──────────────────────────────────────────────────────────
# Misma base MySQL que usa Laravel durante la migración gradual (strangler).
# En desarrollo puedes apuntar a sge_bench para pruebas de carga; nunca uses una base
# de producción desde tu equipo.
DATABASE_URL=mysql://root@127.0.0.1:3306/sge
API_PORT=3100
# Interfaz de escucha. Por defecto solo loopback: la API va detrás de Nginx (ver ts/deploy/nginx). 0.0.0.0 solo en contenedor/red privada.
API_HOST=127.0.0.1

# Mismo valor que TENANCY_BASE_DOMAIN de Laravel (subdominios: {dominio}.{base}).
TENANCY_BASE_DOMAIN=zuraedu.com

# Vida (segundos) de la caché de sesión y de permisos. 0 = desactivada. Máximo 300.
# Es también el retraso MÁXIMO con que esta API nota un token revocado, un usuario desactivado,
# un tenant suspendido o un permiso quitado en Laravel (no hay invalidación cruzada).
AUTH_CACHE_TTL_SECONDS=30
AUTH_CACHE_MAX_ENTRIES=5000

# Peticiones por minuto y por usuario autenticado (igual que RateLimiter::for('api') de Laravel: 60). 0 = sin límite.
# Con REDIS_HOST el contador se comparte entre instancias de la API; sin Redis es por proceso (N instancias = N veces el tope).
# Las peticiones sin token NO se limitan aquí (detrás de un proxy req.ip es la del proxy): usa limit_req de Nginx.
RATE_LIMIT_PER_MINUTE=60

# Sirve el contrato OpenAPI en GET /openapi.json. Es público (describe rutas y validaciones, no contiene datos de
# colegios). Ponlo en false para ocultarlo (responde 404).
OPENAPI_ENABLED=true

# ── Redis (OPCIONAL) ────────────────────────────────────────────────────────
# Mismos nombres y valores que el .env de Laravel: cópialos tal cual. Sin REDIS_HOST la API funciona igual
# (/health informa redis=omitido). Con REDIS_HOST la API puede invalidar las cachés de Laravel (misma base y mismos
# prefijos) y /health pasa a 'degraded' si Redis no responde.
# REDIS_PREFIX y CACHE_PREFIX son OBLIGATORIOS con REDIS_HOST: con un APP_NAME largo el prefijo es largo y no se puede
# adivinar (ej.: psac_politecnico_salesiano_arquides_calderon_database_ / ..._cache_). Usa los del .env de Laravel.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_CACHE_DB=1
# REDIS_PREFIX=
# CACHE_PREFIX=

# ── Reverb / tiempo real (OPCIONAL) ─────────────────────────────────────────
# Mismos nombres y valores que el .env de Laravel. Sin REVERB_APP_ID la API funciona igual pero NO emite eventos en tiempo
# real. Con ella publica en Reverb por HTTP (firmado con el secreto). Las tres credenciales van juntas.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# Endpoint del push de Expo (por defecto el real). Solo se cambia en pruebas.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Pruebas e2e (apps/api, `npm run test:e2e`) ──────────────────────────────
# Base con el tenant 1 y volumen. Las pruebas crean y borran sus propios datos.
# TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/sge_bench
# Redis de las pruebas (usan la base 15 y claves propias; nunca tocan la 1, que es la caché real de Laravel).
# TEST_REDIS_HOST=127.0.0.1
# TEST_REDIS_PORT=6379
# Reverb de pruebas (la prueba se omite si faltan): TEST_REVERB_APP_ID / TEST_REVERB_APP_KEY / TEST_REVERB_APP_SECRET
# (+ TEST_REVERB_HOST, TEST_REVERB_PORT). Arranca uno con `php artisan reverb:start --host=127.0.0.1 --port=8080`.
# PHP_BIN=C:/laragon/bin/php/php-8.3.31-Win32-vs16-x64/php.exe   # activa la prueba cruzada con Laravel real

# ── Web (apps/web) ──────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:3100
