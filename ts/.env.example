# ── API (apps/api) ──────────────────────────────────────────────────────────
# Misma base MySQL que usa Laravel durante la migración gradual (strangler).
# En desarrollo puedes apuntar a sge_bench para pruebas de carga; nunca uses una base
# de producción desde tu equipo.
DATABASE_URL=mysql://root@127.0.0.1:3306/sge
API_PORT=3100

# Mismo valor que TENANCY_BASE_DOMAIN de Laravel (subdominios: {dominio}.{base}).
TENANCY_BASE_DOMAIN=zuraedu.com

# ── Pruebas e2e (apps/api, `npm run test:e2e`) ──────────────────────────────
# Base con el tenant 1 y volumen. Las pruebas crean y borran sus propios datos.
# TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/sge_bench

# ── Web (apps/web) ──────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:3100
