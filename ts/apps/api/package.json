{
  "name": "@zuraedu/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de ZuraEdu. Lee la misma base MySQL que Laravel (migración gradual).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "db:types": "kysely-codegen",
    "db:types:check": "kysely-codegen --verify"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@zuraedu/shared": "0.1.0",
    "ioredis": "^5.11.1",
    "kysely": "0.28.14",
    "mysql2": "^3.24.5",
    "nestjs-cls": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  }
}
